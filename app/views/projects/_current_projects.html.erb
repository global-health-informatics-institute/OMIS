<div class="card h-100 current-projects-card">
  <div class="card-body p-2">
    <h6 class="card-title">Current Projects</h6>
    <table class="table m-0 current-projects-table">
      <thead>
      <tr>
        <th>Donor</th>
        <th>Project Name</th>
        <th>Next Activity</th>
      </tr>
      </thead>
      <tbody>
        <% (@project || []).each do |project| %>
          <tr>
            <td data-label="Donor"><%= project.donor %></td>
            <td data-label="Project Name"><%= project.short_name %></td>
            <td data-label="Next Activity"><%= project.next_deadline %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
