<!-- GHII Templates Modal -->
<div class="modal fade" id="downloadTemplatesModal" tabindex="-1" aria-labelledby="downloadTemplatesModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="downloadTemplatesModalLabel">GHII Templates</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted mb-3">Select a template to edit in Google Drive:</p>
 
        <div class="list-group">
          <!-- Doc Templates -->
          <div class="mb-3">
            <h6 class="text-uppercase text-muted small mb-2">Doc Templates</h6>
 
          <%= link_to GlobalProperty.purchase_request_template_url, 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <%= image_tag 'pdf.png', alt: 'Doc', class: 'me-2', style: 'width: 16px; height: 16px;' %>
              Purchase Request
            </div>
            <small class="text-muted">Docs</small>
          <% end %>
 
          <%= link_to GlobalProperty.travel_request_template_url, 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <%= image_tag 'pdf.png', alt: 'Doc', class: 'me-2', style: 'width: 16px; height: 16px;' %>
              Travel Request
            </div>
            <small class="text-muted">Docs</small>
          <% end %>
 
          <%= link_to GlobalProperty.activity_request_template_url, 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <%= image_tag 'pdf.png', alt: 'Doc', class: 'me-2', style: 'width: 16px; height: 16px;' %>
              Activity Request
            </div>
            <small class="text-muted">Docs</small>
          <% end %>

          <%= link_to GlobalProperty.liquidation_form_template_url, 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <%= image_tag 'xls-file.png', alt: 'XLS', class: 'me-2', style: 'width: 16px; height: 16px;' %>
              Liquidation Form
            </div>
            <small class="text-muted">Sheets</small>
          <% end %>
          </div>
 
          <!-- Excel Templates -->
          <div class="mb-3">
            <h6 class="text-uppercase text-muted small mb-2">Excel Templates</h6>
 
          <%= link_to GlobalProperty.travel_budget_template_url, 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <%= image_tag 'xls-file.png', alt: 'XLS', class: 'me-2', style: 'width: 16px; height: 16px;' %>
              Travel Budget
            </div>
            <small class="text-muted">Sheets</small>
          <% end %>
 
          <%= link_to GlobalProperty.activity_budget_template_url, 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <%= image_tag 'xls-file.png', alt: 'XLS', class: 'me-2', style: 'width: 16px; height: 16px;' %>
              Activity Budget
            </div>
            <small class="text-muted">Sheets</small>
          <% end %>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>