<!-- GHII Templates Modal -->
<div class="modal fade" id="downloadTemplatesModal" tabindex="-1" aria-labelledby="downloadTemplatesModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="downloadTemplatesModalLabel">GHII Templates</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted mb-3">Select a template to edit in Google Drive:</p>
 
        <div class="list-group">
          <!-- Doc Templates -->
          <div class="mb-3">
            <h6 class="text-uppercase text-muted small mb-2">Doc Templates</h6>

 
          <%= link_to "https://docs.google.com/document/d/1YRHpx8-njtb1XACodZqBQNxIQQGOCyIMa0AR7V75A5I/copy",
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <i class="fas fa-file-pdf text-danger me-2"></i>
              <span class="text-primary text-decoration-underline">Travel Request</span>
            </div>
          <% end %>
 
          <!-- Excel Templates -->
          <div class="mb-3 mt-3">
            <h6 class="text-uppercase text-muted small mb-2">Spreadsheet Templates</h6>
 
          <%= link_to "javascript:void(0);",
                class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center disabled",
                tabindex: "-1",
                'aria-disabled' => "true" do %>
            <div>
            <i class="fas fa-file-excel text-success me-2"></i>
            <span class="text-muted text-decoration-underline">Activity Budget</span>
            </div>
          <% end %>

          <%= link_to "javascript:void(0);", 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center disabled",
                      tabindex: "-1",
                      'arial-disabled' => true do %>
            <div>
              <i class="fas fa-file-pdf text-danger me-2"></i>
              <span class="text-muted text-decoration-underline">Activity Request</span>
            </div>
          <% end %>


          <%= link_to "https://docs.google.com/spreadsheets/d/1poXIBxyHAfkSZn0J2JHkL-aD5ptBxlkK/copy",
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <i class="fas fa-file-excel text-success me-2"></i>
              <span class="text-primary text-decoration-underline">Allowance Signing Sheet</span>
            </div>
          <% end %>

          <%= link_to "https://docs.google.com/spreadsheets/d/1B9_4Zw-NaYa_qD__gy8rnHSxO9spycRJrQDJb0mHNHA/copy",
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <i class="fas fa-file-excel text-success me-2"></i>
              <span class="text-primary text-decoration-underline">Liquidation Form</span>
            </div>
          <% end %>

          <%= link_to "https://docs.google.com/spreadsheets/d/1KpUUXJMZQIGqpCJJ3IK6-2LQ9N0Y0wGD/copy",
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <i class="fas fa-file-pdf text-danger me-2"></i>
              <span class="text-primary text-decoration-underline">Purchase Request</span>
            </div>
          <% end %>



          <%= link_to "https://docs.google.com/spreadsheets/d/1TxUaIedQmpnHQUQYx1eYnm_Y3TbkWVof/copy", 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <i class="fas fa-file-excel text-success me-2"></i>
              <span class="text-primary text-decoration-underline">Travel Budget</span>
            </div>
          <% end %>
 

          
          </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>