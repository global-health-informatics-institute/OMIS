<!-- GHII Templates Modal -->
<div class="modal fade" id="downloadTemplatesModal" tabindex="-1" aria-labelledby="downloadTemplatesModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="downloadTemplatesModalLabel">GHII Templates</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted mb-3">Select a template to edit in Google Drive:</p>
 
        <div class="list-group">
          <!-- Doc Templates -->
          <div class="mb-3">
            <h6 class="text-uppercase text-muted small mb-2">Doc Templates</h6>
 
          <%= link_to "https://docs.google.com/document/d/1rj5J_6qNN3BPnzP_hHpO24wKlj4MCeEN1dtaReAoLOQ/copy", 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <i class="fas fa-file-pdf text-danger me-2"></i>
              Purchase Request
            </div>
            <small class="text-muted">Docs</small>
          <% end %>
 
          <%= link_to "https://docs.google.com/document/d/1rj5J_6qNN3BPnzP_hHpO24wKlj4MCeEN1dtaReAoLOQ/copy", 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <i class="fas fa-file-pdf text-danger me-2"></i>
              Travel Request
            </div>
            <small class="text-muted">Docs</small>
          <% end %>
 
          <%= link_to "https://docs.google.com/spreadsheets/d/1KpUUXJMZQIGqpCJJ3IK6-2LQ9N0Y0wGD/copy", 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <i class="fas fa-file-pdf text-danger me-2"></i>
              Activity Request
            </div>
            <small class="text-muted">Docs</small>
          <% end %>

          <%= link_to "https://docs.google.com/spreadsheets/d/1B9_4Zw-NaYa_qD__gy8rnHSxO9spycRJrQDJb0mHNHA/copy", 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              Liquidation Form
            </div>
            <small class="text-muted">Docs</small>
          <% end %>
          </div>
 
          <!-- Excel Templates -->
          <div class="mb-3">
            <h6 class="text-uppercase text-muted small mb-2">Spreadsheet Templates</h6>
 
          <%= link_to "https://docs.google.com/spreadsheets/d/1TxUaIedQmpnHQUQYx1eYnm_Y3TbkWVof/copy", 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <i class="fas fa-file-excel text-success me-2"></i>
              Travel Budget
            </div>
            <small class="text-muted">Sheets</small>
          <% end %>
 
          <%= link_to "https://docs.google.com/spreadsheets/d/1TxUaIedQmpnHQUQYx1eYnm_Y3TbkWVof/copy", 
                      class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                      target: "_blank" do %>
            <div>
              <i class="fas fa-file-excel text-success me-2"></i>
              Activity Budget
            </div>
            <small class="text-muted">Sheets</small>
          <% end %>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>