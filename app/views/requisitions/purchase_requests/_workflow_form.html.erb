<% 
  # Determine which sections the current user is allowed to edit
  core_opts     = { disabled: !@purchase_request.core_editable_by?(current_user) }
  sourcing_qoutations_opts = { disabled: !@purchase_request.sourcing_qoutations_editable_by?(current_user) }
  no_validation_actions = form_validation_bypass_actions
%>

<%= form_with model: [:requisitions, @purchase_request] do |form| %>
<div class="p-3"
     data-controller="quotation-pricing"
     data-quotation-pricing-threshold-value="<%= PurchaseRequest.ipc_threshold %>"
     data-quotation-pricing-cap-rule-value="<%= quotation_cap_rule(@purchase_request) %>">
    <%= render_section_if @purchase_request, :request_details do %>


        <%# Row 1: Initiated By and Date %>
        <div class="row mt-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Initiated By</label>
                        <%= form.text_field :initiated_by,
                                            value: form.object.initiated_by_full_name,
                                            class: 'form-control',
                                            required: true,
                                            readonly: true,
                                            disabled: true
                                            %>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Date</label>
                        <%= form.date_field :initiated_on,
                                            value: form.object.initiated_on&.to_date,
                                            class: 'form-control',
                                            required: true,
                                            readonly: true,
                                            disabled: true
                                            %>
                    </div>
                </div>
        </div>
    <% end %>

    <%= render_section_if @purchase_request, :item_details do %>
        <div class="request-items-list mt-3">
            <%= form.fields_for :requisition_items do |item_form| %>
                <section class="card border-2 shadow-sm mb-3 purchase-request-item">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Item <%= item_form.index.to_i + 1 %></h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <%= item_form.label :item_name, 'Item Name', class: 'form-label fw-normal' %>
                                    <%= item_form.text_field :item_name, class: 'form-control', required: true, **core_opts %>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <%= item_form.label :quantity, 'Quantity', class: 'form-label fw-normal' %>
                                    <%= item_form.number_field :quantity,
                                                               min: 1,
                                                               step: 1,
                                                               class: 'form-control',
                                                               required: true,
                                                               **core_opts %>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <%= item_form.label :item_description, 'Description', class: 'form-label fw-normal' %>
                            <%= item_form.text_area :item_description,
                                                    class: 'form-control',
                                                    rows: 2,
                                                    required: true,
                                                    **core_opts %>
                        </div>

                        <div class="row">
                            <%= item_form.fields_for :requisition_budget_line do |budget_line_form| %>
                                <%= render 'requisitions/purchase_requests/budget_line_field',
                                           rbl_form: budget_line_form,
                                           core_opts: core_opts %>
                            <% end %>
                        </div>
                    </div>
                </section>
            <% end %>
        </div>
    <% end %>

    <%= render_section_if @purchase_request, :request_details do %>
        <%# Row 4: Budget Line and Donor %>
        <div class="row mt-3">

            <%= form.fields_for :requisition_donor do |donor_form| %>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Donor</label>
                        <%= donor_form.select(:donor_id, donors,
                                            { include_blank: 'Select Donor' },
                                            { class: 'form-control form-select', required: true, **core_opts }) %>
                    </div>
                </div>
            <% end %>

            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Requisition Purpose</label>
                    <%= form.text_field :purpose,
                                        class: 'form-control',
                                        required: true,
                                        **core_opts %>
                </div>
            </div>
        </div>

        <%# Row 5: Project and Department %>
        <div class="row mt-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Project</label>
                        <%= form.select(:project_id, requisition_projects, 
                                        { include_blank: 'Select Project' }, 
                                        { class: 'form-control form-select', required: true, **core_opts }) %>
                    </div>
                </div>

                <%= form.fields_for :purchase_request_detail do |detail_form| %>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-normal">Department</label>
                            <%= detail_form.select(:department_id, purchase_request_departments,
                                                   { include_blank: 'Select Department' },
                                                   { class: 'form-control form-select', required: true, **core_opts }) %>
                        </div>
                    </div>
                <% end %>
        </div>
    <% end %>

    <%# Approval Section %>
    <%= render_section_if @purchase_request, :approval do %>
        <hr>
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Approved By</label>
                    <%= form.text_field :approved_by, 
                                        value: form.object.approved_by_full_name, 
                                        class: 'form-control', 
                                        required: true, 
                                        **core_opts %>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Approved on</label>
                    <%= form.text_field :approved_on, 
                                        value: form.object.approved_on&.to_date&.strftime('%d-%b-%Y'), 
                                        class: 'form-control', 
                                        required: true, 
                                        **core_opts %>
                </div>
            </div>
        </div>
        <% end %>

    <%# Sourcing Section %>
    <%= render_section_if @purchase_request, :sourcing_qoutations do %>
        <hr>
        <%= form.fields_for :purchase_request_detail do |detail_form| %>
            <div class="row mt-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Name of Supplier</label>
                        <%= form.text_field :vendor_name,
                                            class: 'form-control',
                                            required: true,
                                            **sourcing_qoutations_opts %>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Supplier Phone Number</label>
                        <%= detail_form.telephone_field :vendor_mobile_number,
                                                        maxlength: 10,
                                                        class: 'form-control',
                                                        autocomplete: 'tel',
                                                        inputmode: 'tel',
                                                        pattern: '^[0-9]{7,10}$',
                                                        data: { action: 'input->quotation-pricing#sanitizePhone' },
                                                        placeholder: 'e.g. 0991234567',
                                                        title: 'Enter a valid phone number with 7 to 10 digits.',
                                                        required: true,
                                                        **sourcing_qoutations_opts %>
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Supplier Email</label>
                        <%= detail_form.email_field :vendor_email,
                                                    class: 'form-control',
                                                    autocomplete: 'email',
                                                    required: true,
                                                    **sourcing_qoutations_opts %>
                    </div>
                </div>
            </div>
        <% end %>

        <section class="mt-4">
            <h6 class="mb-1">Vendor Analysis</h6>
            <p class="text-muted small mb-3">Enter a unit cost and select the charges that apply to each item.</p>

            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="border-2">#</th>
                            <th scope="col" class="border-2">Item Name</th>
                            <th scope="col" class="text-end border-2">Qty</th>
                            <% vendor_analysis_charges.each do |charge| %>
                                <th scope="col" class="text-center border-2"><%= vendor_analysis_charge_label(charge) %></th>
                            <% end %>
                            <th scope="col" class="text-end border-2">Unit Cost (MWK)</th>
                            <th scope="col" class="text-end border-2">Total Cost (MWK)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <%= form.fields_for :requisition_items do |item_form| %>
                            <% item = item_form.object %>
                            <tr data-quotation-pricing-target="item"
                                data-quotation-pricing-quantity-value="<%= item.quantity %>">
                                <th scope="row" class="border-2"><%= item_form.index.to_i + 1 %></th>
                                <td class="border-2"><%= item.item_name %></td>
                                <td class="text-end border-2"><%= number_with_precision(item.quantity, precision: 2, strip_insignificant_zeros: true) %></td>
                                <% vendor_analysis_charges.each do |charge| %>
                                    <% input_id = "quotation_item_#{item.requisition_item_id || item_form.index}_charge_#{charge.id}" %>
                                    <td class="px-3 border-2">
                                        <div class="form-check d-flex align-items-center gap-2 mb-0 ps-0">
                                            <%= check_box_tag "quotation_item_charges[#{item.requisition_item_id || item_form.index}][]",
                                                              charge.id,
                                                              false,
                                                              id: input_id,
                                                              class: 'form-check-input mt-0 ms-0 fs-4 border border-2 border-dark',
                                                              disabled: sourcing_qoutations_opts[:disabled],
                                                              data: {
                                                                quotation_pricing_target: 'charge',
                                                                charge_type: charge.value_type,
                                                                charge_value: charge.value,
                                                                action: 'change->quotation-pricing#refresh'
                                                              } %>
                                            <label class="form-check-label small" for="<%= input_id %>">Yes</label>
                                        </div>
                                    </td>
                                <% end %>
                                <td class="border-2">
                                    <%= text_field_tag "quotation_item_unit_prices[#{item.requisition_item_id || item_form.index}]",
                                                       nil,
                                                       inputmode: 'decimal',
                                                       autocomplete: 'off',
                                                       class: 'form-control form-control-sm text-end border-2 border-dark',
                                                       required: true,
                                                       disabled: sourcing_qoutations_opts[:disabled],
                                                       title: 'Enter a valid amount greater than 0, e.g. 1500 or 1500.50',
                                                       data: {
                                                         quotation_pricing_target: 'unitPrice',
                                                         action: 'input->quotation-pricing#sanitizeUnitPrice input->quotation-pricing#refresh'
                                                       } %>
                                </td>
                                <td class="text-end fw-semibold border-2">
                                    <output aria-live="polite" data-quotation-pricing-target="itemTotal">0.00</output>
                                </td>
                            </tr>
                        <% end %>
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="<%= vendor_analysis_charges.size + 4 %>" class="text-end border-2">Calculated Total Cost (MWK)</th>
                            <td class="text-end fw-bold border-2"><output aria-live="polite" data-quotation-pricing-target="lineTotal">0.00</output></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="small mt-1" aria-live="polite" data-quotation-pricing-target="capMessage"></div>
        </section>
    <% end %>

    <%# lpo check %>
    <%= render_section_if @purchase_request, :lpo_check do %>
        <hr>
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Does the supplier Accept LPO for This Purchase?</label>
                </div>
            </div>
        </div>

        <div class="row mb-4 justify-content-center">
            <div class="col-md-10">
                <div class="d-flex justify-content-center gap-4 flex-wrap">
                    <div class="flex-fill text-center">
                        <%= button_tag 'Yes, Item can be Procured through LPO',
                                       type: :submit,
                                       formaction: route_to_lpo_request_requisitions_purchase_request_path(@purchase_request),
                                       formnovalidate: true,
                                       class: 'btn btn-outline-primary w-100 py-4 fs-5 fw-semibold',
                                       data: { turbo_confirm: 'Route this purchase request for LPO submission?' } %>
                    </div>

                    <div class="flex-fill text-center">
                        <%= button_tag 'No, Continue to Payment Request',
                                       type: :submit,
                                       formaction: forward_to_payment_request_requisitions_purchase_request_path(@purchase_request),
                                       formnovalidate: true,
                                       class: 'btn btn-outline-primary w-100 py-4 fs-5 fw-semibold',
                                       data: { turbo_confirm: 'Forward this purchase request to payment request?' } %>
                    </div>
                </div>
            </div>
        </div>
    <% end %>

    <%# purchase request %>
    <%= render_section_if @purchase_request, :payment_request do %>

    <% end %>


    <%= render_section_if @purchase_request, :action_items do %>
        <% if @possible_actions.present? %>
            <div class="row p-3">
                <div class="col gap-2 d-flex">
                    <% @possible_actions.each do |action| %>
                        <% action_label = purchase_request_action_label(action) %>
                        <% if action == 'Route to IPC - Vendor Analysis' %>
                            <%= link_to action_label,
                                        schedule_ipc_meeting_requisitions_purchase_request_path(@purchase_request),
                                        class: "btn #{available_actions_badge_class(action)}",
                                        data: { turbo_frame: 'remote_modal' } %>
                        <% else %>
                            <% route_verb = action_route_verb(action) %>
                            <% dynamic_path = send("#{route_verb}_requisitions_purchase_request_path", @purchase_request) %>
                            <% button_data = { turbo_confirm: "Are you sure you want to #{action.downcase}?" } %>
                            <% button_data[:quotation_pricing_target] = 'saveAction' if action.casecmp?('Save Qoutation') %>
                            <%= button_tag action_label,
                                            type: :submit,
                                            formaction: dynamic_path,
                                            formnovalidate: no_validation_actions.include?(action.downcase),
                                            class: "btn #{available_actions_badge_class(action)}",
                                            data: button_data %>
                        <% end %>
                    <% end %>
                </div>
            </div>
        <% end %>
    <% end %>

    <%= render 'workflow_step_card', purchase_request: @purchase_request %>

  </div>
<% end %>
