<% 
  # Determine which sections the current user is allowed to edit
  core_opts     = { disabled: !@purchase_request.core_editable_by?(current_user) }
  sourcing_qoutations_opts = { disabled: !@purchase_request.sourcing_qoutations_editable_by?(current_user) }
  no_validation_actions = form_validation_bypass_actions
%>

<%= form_with model: [:requisitions, @purchase_request] do |form| %>
<div class="p-3"
     data-controller="quotation-pricing"
     data-quotation-pricing-levy-rate-value="<%= GlobalProperty.levy_rate %>"
     data-quotation-pricing-mra-rate-value="<%= GlobalProperty.mra_rate %>"
     data-quotation-pricing-threshold-value="<%= PurchaseRequest.ipc_threshold %>"
     data-quotation-pricing-cap-rule-value="<%= quotation_cap_rule(@purchase_request) %>">
    <%= render_section_if @purchase_request, :request_details do %>


        <%# Row 1: Initiated By and Date %>
        <div class="row mt-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Initiated By</label>
                        <%= form.text_field :initiated_by,
                                            value: form.object.initiated_by_full_name,
                                            class: 'form-control',
                                            required: true,
                                            readonly: true,
                                            disabled: true
                                            %>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Date</label>
                        <%= form.date_field :initiated_on,
                                            value: form.object.initiated_on&.to_date,
                                            class: 'form-control',
                                            required: true,
                                            readonly: true,
                                            disabled: true
                                            %>
                    </div>
                </div>
        </div>
    <% end %>

    <%= render_section_if @purchase_request, :item_details do %>
        <%# Row 2 & 3: Item Name, Quantity, and Description %>
        <div class="row mt-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Item Name</label>
                        <%= form.text_field :purpose,
                                            class: 'form-control',
                                            required: true,
                                            **core_opts %>
                    </div>
                </div>

                <%= form.fields_for :requisition_items do |item_form| %>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-normal">Quantity</label>
                            <%= item_form.number_field :quantity,
                                                    min: 1,
                                                    step: 1,
                                                    class: 'form-control',
                                                    required: true,
                                                    **core_opts %>
                        </div>
                    </div>
            </div> 

            <div class="row mt-3">
                <div class="col-md-12">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Description</label>
                        <%= item_form.text_area :item_description,
                                                class: 'form-control',
                                                rows: 2,
                                                required: true,
                                                **core_opts %>
                    </div>
                </div>
                <% end %>
        </div>
    <% end %>

    <%= render_section_if @purchase_request, :request_details do %>
        <%# Row 4: Budget Line and Donor %>
        <div class="row mt-3">
                <%= form.fields_for :requisition_budget_line do |rbl_form| %>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-normal">Budget Line</label>
                            <%= rbl_form.select(:budget_line_id, budget_lines, 
                                                { include_blank: 'Select Budget Line' }, 
                                                { class: 'form-control form-select', required: true, **core_opts }) %>
                        </div>
                    </div>
                <% end %>

                <%= form.fields_for :requisition_donor do |donor_form| %>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-normal">Donor</label>
                            <%= donor_form.select(:donor_id, donors, 
                                                { include_blank: 'Select Donor' }, 
                                                { class: 'form-control form-select', required: true, **core_opts }) %>
                        </div>
                    </div>
                <% end %>
        </div>

        <%# Row 5: Project and Department %>
        <div class="row mt-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal">Project</label>
                        <%= form.select(:project_id, requisition_projects, 
                                        { include_blank: 'Select Project' }, 
                                        { class: 'form-control form-select', required: true, **core_opts }) %>
                    </div>
                </div>

                <%= form.fields_for :purchase_request_detail do |detail_form| %>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-normal">Department</label>
                            <%= detail_form.select(:department_id, purchase_request_departments,
                                                   { include_blank: 'Select Department' },
                                                   { class: 'form-control form-select', required: true, **core_opts }) %>
                        </div>
                    </div>
                <% end %>
        </div>
    <% end %>

    <%# Approval Section %>
    <%= render_section_if @purchase_request, :approval do %>
        <hr>
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Approved By</label>
                    <%= form.text_field :approved_by, 
                                        value: form.object.approved_by_full_name, 
                                        class: 'form-control', 
                                        required: true, 
                                        **core_opts %>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Approved on</label>
                    <%= form.date_field :approved_on, 
                                        value: form.object.approved_on&.to_date, 
                                        class: 'form-control', 
                                        required: true, 
                                        **core_opts %>
                </div>
            </div>
        </div>
        <% end %>

    <%# Sourcing Section %>
    <%= render_section_if @purchase_request, :sourcing_qoutations do %>
        <hr>
        <div data-quotation-pricing-target="item"
             data-quotation-pricing-quantity="<%= @purchase_request.purchase_request_detail.quotation_quantity %>">
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Name of Supplier</label>
                    <%# ONLY SOURCING OPTS APPLIED HERE %>
                    <%= form.text_field :vendor_name, 
                                        class: 'form-control', 
                                        required: true, 
                                        **sourcing_qoutations_opts %>
                </div>
            </div>

            <%= form.fields_for :purchase_request_detail do |detail_form| %>
        

            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Supplier Mobile Number</label>
                    <%= detail_form.telephone_field :vendor_mobile_number,
                                class: 'form-control',
                                autocomplete: 'tel',
                                inputmode: 'tel',
                                pattern: '^[0-9+\(\) \-]{7,20}$',
                                title: 'Enter a valid phone number with 7 to 20 characters.',
                                required: true,
                                **sourcing_qoutations_opts %>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Supplier Email</label>
                    <%= detail_form.email_field :vendor_email,
                                                class: 'form-control',
                                                autocomplete: 'email',
                                                required: true,
                                                **sourcing_qoutations_opts %>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Unit Price (MWK)</label>
                    <%= detail_form.number_field :unit_price,
                                                 min: 0.01,
                                                 step: 0.01,
                                                 class: 'form-control',
                                                 required: true,
                                                 data: { quotation_pricing_target: 'unitPrice', action: 'input->quotation-pricing#refresh' },
                                                 **sourcing_qoutations_opts %>
                </div>
            </div>
        </div>

        <div class="row mt-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal d-block">Attracts Levy? (<%= number_to_percentage(GlobalProperty.levy_rate * 100, precision: 2, strip_insignificant_zeros: true) %>)</label>
                        <div class="btn-group" role="group" aria-label="Attracts levy">
                            <%= detail_form.radio_button :attracts_levy, true,
                                                        required: true,
                                                        class: 'btn-check',
                                                        data: { quotation_pricing_target: 'levy', action: 'change->quotation-pricing#refresh' },
                                                        disabled: sourcing_qoutations_opts[:disabled] %>
                            <%= detail_form.label :attracts_levy_true, 'Yes', class: 'btn btn-outline-primary px-4' %>
                            <%= detail_form.radio_button :attracts_levy, false,
                                                        class: 'btn-check',
                                                        data: { quotation_pricing_target: 'levy', action: 'change->quotation-pricing#refresh' },
                                                        disabled: sourcing_qoutations_opts[:disabled] %>
                            <%= detail_form.label :attracts_levy_false, 'No', class: 'btn btn-outline-danger px-4' %>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-normal d-block">Attracts MRA? (<%= number_to_percentage(GlobalProperty.mra_rate * 100, precision: 2, strip_insignificant_zeros: true) %>)</label>
                        <div class="btn-group" role="group" aria-label="Attracts MRA">
                            <%= detail_form.radio_button :attracts_mra, true,
                                                        required: true,
                                                        class: 'btn-check',
                                                        data: { quotation_pricing_target: 'mra', action: 'change->quotation-pricing#refresh' },
                                                        disabled: sourcing_qoutations_opts[:disabled] %>
                            <%= detail_form.label :attracts_mra_true, 'Yes', class: 'btn btn-outline-primary px-4' %>
                            <%= detail_form.radio_button :attracts_mra, false,
                                                        class: 'btn-check',
                                                        data: { quotation_pricing_target: 'mra', action: 'change->quotation-pricing#refresh' },
                                                        disabled: sourcing_qoutations_opts[:disabled] %>
                            <%= detail_form.label :attracts_mra_false, 'No', class: 'btn btn-outline-danger px-4' %>
                        </div>
                    </div>
                </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Calculated Total Cost (MWK)</label>
                    <output class="form-control bg-light" aria-live="polite" data-quotation-pricing-target="lineTotal">0.00</output>
                    <div class="small mt-1" aria-live="polite" data-quotation-pricing-target="capMessage"></div>
                </div>
            </div>
        </div>
            <% end %>
        </div>
    <% end %>

    <%# lpo check %>
    <%= render_section_if @purchase_request, :lpo_check do %>
        <hr>
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-normal">Does the supplier Accept LPO for This Purchase?</label>
                </div>
            </div>
        </div>

        <div class="row mb-4 justify-content-center">
            <div class="col-md-10">
                <div class="d-flex justify-content-center gap-4 flex-wrap">
                    <div class="flex-fill text-center">
                        <%= button_tag 'Yes, Item can be Procured through LPO',
                                       type: :submit,
                                       formaction: route_to_lpo_request_requisitions_purchase_request_path(@purchase_request),
                                       formnovalidate: true,
                                       class: 'btn btn-outline-primary w-100 py-4 fs-5 fw-semibold',
                                       data: { turbo_confirm: 'Route this purchase request for LPO submission?' } %>
                    </div>

                    <div class="flex-fill text-center">
                        <%= button_tag 'No, Continue to Payment Request',
                                       type: :submit,
                                       formaction: forward_to_payment_request_requisitions_purchase_request_path(@purchase_request),
                                       formnovalidate: true,
                                       class: 'btn btn-outline-primary w-100 py-4 fs-5 fw-semibold',
                                       data: { turbo_confirm: 'Forward this purchase request to payment request?' } %>
                    </div>
                </div>
            </div>
        </div>
    <% end %>

    <%# purchase request %>
    <%= render_section_if @purchase_request, :payment_request do %>

    <% end %>


    <%= render_section_if @purchase_request, :action_items do %>
        <% if @possible_actions.present? %>
            <div class="row p-3">
                <div class="col gap-2 d-flex">
                    <% @possible_actions.each do |action| %>
                        <% 
                            route_verb = action_route_verb(action)
                            dynamic_path = send("#{route_verb}_requisitions_purchase_request_path", @purchase_request)
                        %>
                        
                        <%# 
                            button_tag with type="submit" and "formaction" tells the browser to submit 
                            the form data, but push it to the custom URL instead of the default form URL.
                        %>
                        <% button_data = { turbo_confirm: "Are you sure you want to #{action.downcase}?" } %>
                        <% button_data[:quotation_pricing_target] = 'saveAction' if action.casecmp?('Save Qoutation') %>
                        <%= button_tag action, 
                                        type: :submit, 
                                        formaction: dynamic_path, 
                                        formnovalidate: no_validation_actions.include?(action.downcase),
                                        class: "btn #{available_actions_badge_class(action)}",
                                        data: button_data %>
                    <% end %>
                </div>
            </div>
        <% end %>
    <% end %>

  </div>
<% end %>
