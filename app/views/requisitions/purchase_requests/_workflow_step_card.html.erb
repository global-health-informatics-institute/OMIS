<% workflow_step = workflow_step_information(purchase_request) %>

<div class="card border-start border-secondary-subtle border-4 mt-3">
    <div class="card-body p-3">
        <div>
            <div class="small text-body-secondary fw-semibold mb-1">CURRENT STEP</div>
            <p class="mb-0"><%= workflow_step[:description] %></p>
        </div>

        <% if workflow_step[:actors].present? %>
            <div class="mt-3">
                <div class="small text-body-secondary fw-semibold mb-1">EXPECTED TO ACT</div>
                <p class="mb-0"><%= workflow_step[:actors].to_sentence %></p>
            </div>
        <% end %>

        <div class="mt-3">
            <div class="small text-body-secondary fw-semibold mb-2">POSSIBLE NEXT ACTIONS</div>
            <% if workflow_step[:next_steps].present? %>
                <ul class="list-unstyled mb-0">
                    <% workflow_step[:next_steps].each do |next_step| %>
                        <li class="py-1">
                            <span class="d-inline-block fw-semibold" style="width: 14rem"><%= next_step[:action] %></span>
                            <span class="text-body-secondary"><%= next_step[:description] %></span>
                        </li>
                    <% end %>
                </ul>
            <% else %>
                <p class="mb-0 text-body-secondary">No further workflow action is required.</p>
            <% end %>
        </div>
    </div>
</div>
