<%# #<Requisition requisition_id: 149, purpose: "Item 1", initiated_by: 80, initiated_on: "2026-09-01 00:00:00.000000000 +0000", requisition_type: "Purchase Request", reviewed_by: nil, approved_by: nil, workflow_state_id: 39, voided: false, created_at: "2026-09-01 08:32:11.960988000 +0000", updated_at: "2026-09-01 08:32:11.960988000 +0000", project_id: 12> %>

    <%# mother card  %>
    <div class="card mt-3">


        <div class="card-header card-header-dark">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0">Purchase Request</h5>
                </div>
                <div class="col text-end">
                    <span class="badge <%= purchase_request_state_badge_class(@purchase_request.current_state) %> p-3 fs-6">
                        <%= @purchase_request.current_state %>
                        </span>
                </div>
            </div>
        </div>

        <%# dynamic rendering %>
        <% if current_user.employee&.employee_id.equal?(@purchase_request.initiated_by) %>
            <%= render "pending_supervisor_review" %>
        <%else%>
            <%= render "#{(@purchase_request.current_state).downcase.gsub(' ', '_')}" %>
        <% end %>
        <%# end of dynamic rendering %>

</div>
