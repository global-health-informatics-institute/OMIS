<%= turbo_frame_tag 'remote_modal' do %>
    <div class="modal fade" id="ipcMeetingModal" tabindex="-1" aria-labelledby="ipcMeetingModalLabel" aria-hidden="true"
         data-controller="remote-modal" data-action="turbo:before-render@document->remote-modal#hideBeforeRender">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="ipcMeetingModalLabel">Schedule Committee Meeting</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p>
                        Choose the committee, date, and time. All active members of that committee will receive an invitation.
                    </p>

                    <%= form_with model: @committee_meeting,
                                  url: route_to_ipc_vendor_analysis_requisitions_purchase_request_path(@purchase_request),
                                  method: :patch,
                                  data: { turbo_frame: '_top' } do |form| %>
                        <% if @committee_meeting.errors.any? %>
                            <div class="alert alert-danger">
                                <%= @committee_meeting.errors.full_messages.to_sentence %>
                            </div>
                        <% end %>

                        <div class="mb-3">
                            <%= form.label :committee_id, 'Committee', class: 'form-label' %>
                            <%= form.collection_select :committee_id,
                                                       @committees,
                                                       :committee_id,
                                                       :name,
                                                       { include_blank: 'Select committee' },
                                                       { class: 'form-select', required: true } %>
                        </div>

                        <div class="mb-3">
                            <%= form.label :scheduled_on, 'IPC meeting date and time', class: 'form-label' %>
                            <%= form.datetime_local_field :scheduled_on,
                                                          min: Time.current.strftime('%Y-%m-%dT%H:%M'),
                                                          class: 'form-control',
                                                          required: true %>
                        </div>

                        <div class="d-flex justify-content-start gap-2">
                            <button type="button" class="btn btn-warning" data-bs-dismiss="modal">Cancel</button>
                            <%= form.submit 'Schedule Meeting and Notify Members', class: 'btn btn-primary' %>
                        </div>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
<% end %>
