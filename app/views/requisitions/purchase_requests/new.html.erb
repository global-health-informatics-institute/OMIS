<h4 class="mb-4">Purchase Request</h4>

<%= form_with model: [:requisitions, @purchase_request], url: requisitions_purchase_requests_path, method: :post do |form| %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <h5 class="mb-3">Request details</h5>

      <div class="row mt-3">
        <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label fw-normal">Initiated By</label>
            <%= form.text_field :initiated_by, value: current_user.full_name, class: 'form-control', required: true, readonly: true %>
          </div>
        </div>

        <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label fw-normal">Date</label>
            <%= form.date_field :initiated_on, value: Date.today, class: 'form-control', required: true, readonly: true %>
          </div>
        </div>
      </div>

      <div class="row mt-3">
        <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label fw-normal">Project</label>
            <%= form.select :project_id, requisition_projects, { include_blank: 'Select Project' }, { class: 'form-control form-select', required: true } %>
          </div>
        </div>

        <%= form.fields_for :purchase_request_detail do |detail_form| %>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label fw-normal">Department</label>
              <%= detail_form.select :department_id, purchase_request_departments, { include_blank: 'Select Department' }, { class: 'form-control form-select', required: true } %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="row mt-3">
        <%= form.fields_for :requisition_donor do |donor_form| %>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label fw-normal">Donor</label>
              <%= donor_form.select :donor_id, donors, { include_blank: 'Select Donor' }, { class: 'form-control form-select', required: true } %>
            </div>
          </div>
        <% end %>
      </div>

      <div data-controller="request-items"
           data-action="input->request-items#syncPurpose change->request-items#syncBudget">
        <%= form.hidden_field :purpose, data: { request_items_target: 'purpose' } %>
        <%= hidden_field_tag 'purchase_request[requisition_budget_line_attributes][budget_line_id]',
                             nil,
                             data: { request_items_target: 'budgetLine' } %>

        <hr class="my-4">

        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <h5 class="mb-1">Requested items</h5>
            <p class="text-muted mb-0">Add each item with its quantity, description, and budget line.</p>
          </div>
          <span class="badge text-bg-secondary px-3 py-2 fs-6" data-request-items-target="count" aria-live="polite"></span>
        </div>

        <div class="request-items-list" data-request-items-target="rows">
          <%= form.fields_for :requisition_items do |item_form| %>
            <%= render 'requisitions/purchase_requests/item_fields', item_form: item_form, core_opts: {} %>
          <% end %>
        </div>

        <template data-request-items-target="template">
          <%= form.fields_for :requisition_items, RequisitionItem.new, child_index: 'NEW_RECORD' do |item_form| %>
            <%= render 'requisitions/purchase_requests/item_fields', item_form: item_form, core_opts: {} %>
          <% end %>
        </template>

        <button type="button" class="btn btn-primary mt-2" data-action="request-items#add">
          <span aria-hidden="true">+</span> Add another item
        </button>
      </div>

      <div class="d-flex justify-content-end mt-4">
        <%= form.submit "Submit Request", class: "btn btn-success" %>
      </div>
    </div>
  </div>
<% end %>
