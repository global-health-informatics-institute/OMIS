<% unless controller_name == 'tc_dashboard' %>
<!DOCTYPE html>
<html>
  <head>
    <title>OMIS</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <main role="main" class="position-fixed top-0 bottom-0 start-0 end-0 d-flex flex-column overflow-hidden">
      <nav class="navbar navbar-expand-sm bg-dark navbar-dark flex-shrink-0">
        <div class="container-fluid">
          <a class="navbar-brand order-1 order-sm-0 ms-auto ms-sm-0 me-0 me-sm-3" href="#">
            <img src="/assets/ic_omis.png" alt="" width="30" height="24" class="d-inline-block align-text-top">
            OMIS
          </a>
          <button class="navbar-toggler d-sm-none order-0" style="--bs-navbar-toggler-focus-width: 0;" type="button" data-bs-toggle="offcanvas" data-bs-target="#sideNavigation" aria-controls="sideNavigation" aria-label="Open menu">
            <span class="navbar-toggler-icon"></span>
          </button>
        </div>
      </nav>
      <div class="d-flex flex-grow-1 overflow-hidden">
        <div class="d-flex flex-shrink-0 overflow-hidden bg-dark">
          <div id="sideNavigation" class="offcanvas-sm offcanvas-start d-flex flex-column flex-shrink-0 overflow-hidden bg-dark p-2" tabindex="-1" aria-label="Main navigation">
            <div class="d-flex align-items-center justify-content-between flex-shrink-0 d-sm-none mt-3 px-2 pb-2">
              <a class="d-flex align-items-center gap-2 fs-5 text-light text-decoration-none" href="/" aria-label="OMIS home">
                <img src="/assets/ic_omis.png" alt="" width="30" height="24">
                <span>OMIS</span>
              </a>
              <button class="btn-close btn-close-white" type="button" data-bs-dismiss="offcanvas" data-bs-target="#sideNavigation" aria-label="Close menu"></button>
            </div>
            <ul class="nav navbar-nav flex-grow-1 flex-nowrap overflow-y-auto overflow-x-hidden">
              <li class ="nav-item ms-1 d-none d-sm-block">
                <button class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" type="button" data-bs-toggle="collapse" data-bs-target=".multi-collapse" title="Menu">
                  <img src="/assets/menu.png" alt="Menu" width="25" height="25">
                  <span class="d-sm-none ms-2 text-light">Menu</span>
                  <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Menu</span></span>
                </button>
              </li>
              <li class ="nav-item ms-1">
                <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/" data-bs-toggle="tooltip" title="Home">
                  <img src="/assets/home.png" alt="Home" width="25" height="25">
                  <span class="d-sm-none ms-2 text-light">Home</span>
                  <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Home</span></span>
                </a>
              </li>
              <% if current_user %>
                <li class ="nav-item ms-1">
                  <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/timesheets/<%=current_timesheet.timesheet_id rescue ''%>" data-bs-toggle="tooltip" title="Timesheets">
                    <img src="/assets/schedule.png" alt="Timesheets" width="25" height="25">
                    <span class="d-sm-none ms-2 text-light">Timesheet</span>
                    <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Timesheet</span></span>
                  </a>
                </li>
                <li class ="nav-item ms-1">
                  <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/requisitions/" data-bs-toggle="tooltip" title="Requisitions">
                    <img src="/assets/requestion.png" alt="Requisitions" width="25" height="25">
                    <span class="d-sm-none ms-2 text-light">Requistions</span>
                    <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Requistions</span></span>
                  </a>
                </li>
                <!--
                <li class ="nav-item ms-1">
                  <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/projects" data-bs-toggle="tooltip" title="Programs">
                    <img src="/assets/program.png" alt="Programs" width="25" height="25">
                    <span class="d-sm-none ms-2 text-light">Programs</span>
                    <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Programs</span></span>
                  </a>
                </li> !-->
                <li class ="nav-item ms-1">
                  <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/employees" data-bs-toggle="tooltip" title="Personnel">
                    <img src="/assets/personnel.png" alt="Personnel" width="25" height="25">
                    <span class="d-sm-none ms-2 text-light">Personnel</span>
                    <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Personnel</span></span>
                  </a>
                </li>
                <li class ="nav-item ms-1">
                  <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/inventory_items" data-bs-toggle="tooltip" title="Inventory">
                    <img src="/assets/inventory.png" alt="Inventory" width="25" height="25">
                    <span class="d-sm-none ms-2 text-light">Inventory</span>
                    <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Inventory</span></span>
                  </a>
                </li>
                <li class ="nav-item ms-1">
                  <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/business_assets" data-bs-toggle="tooltip" title="Assets">
                    <img src="/assets/asset.png" alt="Assets" width="25" height="25">
                    <span class="d-sm-none ms-2 text-light">Assets</span>
                    <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Assets</span></span>
                  </a>
                </li>
                <li class ="nav-item ms-1">
                  <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/reports/index" data-bs-toggle="tooltip" title="Reports">
                    <img src="/assets/report.png" alt="Reports" width="25" height="25">
                    <span class="d-sm-none ms-2 text-light">Reports</span>
                    <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Reports</span></span>
                  </a>
                </li>
                <!--
                <li class ="nav-item ms-1">
                  <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="#" data-bs-toggle="tooltip" title="Complaints">
                    <img src="/assets/Complaint.png" alt="Complaints" width="25" height="25">
                    <span class="d-sm-none ms-2 text-light">Complaint</span>
                    <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Complaint</span></span>
                  </a>
                </li> !-->
              <% end %>
            </ul>
            <footer class="flex-shrink-0 mt-auto border-top border-secondary pt-2">
              <ul class="nav navbar-nav">
                <li class="nav-item ms-1">
                  <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/about" data-bs-toggle="tooltip" title="About">
                    <%= image_tag "Info-icon.png", alt: "", width: 25, height: 25 %>
                    <span class="d-sm-none ms-2 text-light">About</span>
                    <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">About</span></span>
                  </a>
                </li>
                <% if current_user %>
                  <li class="nav-item ms-1">
                  <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/users/<%= current_user.user_id %>" data-bs-toggle="tooltip" title="<%= current_user.username %>">
                    <%= image_tag "User-icon.png", alt: "", width: 25, height: 25 %>
                    <span class="d-sm-none ms-2 text-light"><%= current_user.username %></span>
                    <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light"><%= current_user.username %></span></span>
                    </a>
                  </li>
                  <li class="nav-item ms-1">
                    <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/logout" data-bs-toggle="tooltip" title="Logout">
                      <%= image_tag "login.png", alt: "", width: 25, height: 25 %>
                      <span class="d-sm-none ms-2 text-light">Logout</span>
                      <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Logout</span></span>
                    </a>
                  </li>
                <% else %>
                  <li class="nav-item ms-1">
                    <a class="nav-link py-2 px-2 text-nowrap" style="font-size: 16px;" href="/user_sessions/new" data-bs-toggle="tooltip" title="Login">
                      <%= image_tag "login.png", alt: "", width: 25, height: 25 %>
                      <span class="d-sm-none ms-2 text-light">Login</span>
                      <span class="d-none d-sm-inline"><span class="collapse multi-collapse ms-2 text-light">Login</span></span>
                    </a>
                  </li>
                <% end %>
              </ul>
            </footer>
          </div>
        </div>
        <div class="flex-grow-1 overflow-auto p-2">
          <%= render partial: 'layouts/notices' %>
          <%= yield %>
          <%= turbo_frame_tag "remote_modal", target: "_top" %>
        </div>
      </div>
    </main>
    <% else %>
      <%= yield %>
    <%end%>
    <main>

    </main>
  </body>
</html>
