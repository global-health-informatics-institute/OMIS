<% unless controller_name == 'tc_dashboard' %>
<!DOCTYPE html>
<html>
  <head>
    <title>OMIS</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <main role="main" class="d-flex flex-column vh-100 vw-100">
      <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
          <div class="d-flex align-items-center min-w-0">
            <a class="navbar-brand" href="#">
              <img src="/assets/ic_omis.png" alt="" height="24" class="d-inline-block align-text-top" style="width: auto; object-fit: contain;">
              OMIS
            </a>
            <nav class="top-nav-breadcrumb text-white-50 small text-truncate" aria-label="Breadcrumb">
              <% page_breadcrumb.each_with_index do |crumb, index| %>
                <% if index.positive? %>
                  <%= bootstrap_icon "chevron-right", width: 12, height: 12, class: "mx-1", aria: { hidden: true } %>
                <% end %>
                <%= link_to crumb[:label], crumb[:path], class: "text-white-50 text-decoration-none" %>
              <% end %>
            </nav>
          </div>
          <button class="btn btn-link d-md-none p-1 ms-auto text-white text-decoration-none mobile-side-nav-toggle" id="mobileSideNavToggle" type="button" aria-controls="sideNavigation" aria-expanded="false" aria-label="Expand navigation">
            <%= bootstrap_icon "chevron-right", width: 20, height: 20, aria: { hidden: true } %>
            <span class="ms-1 fw-bold text-decoration-none">Menu</span>
          </button>
          <div class="collapse navbar-collapse justify-content-end" id="collapsibleNavbar">
            <ul class="navbar-nav">
              <li class="nav-item">
                <a class="nav-link" href="/about">About</a>
              </li>
              <% if current_user %>
                <!--
                <li class="nav-item">
                  <a class="nav-link" href="#">Settings</a>
                </li> !-->
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                    <%= current_user.username %>
                  </a>
                  <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="/users/<%= current_user.user_id%>">User Profile</a></li>
                    <li><a class="dropdown-item" href="/logout">Logout</a></li>
                  </ul>
                </li>
              <% else %>
                <a class="nav-link" href="/user_sessions/new" >Login</a>
              <% end %>
            </ul>
          </div>
        </div>
      </nav>
      <div class="flex-grow-1 row vw-100" style="height: calc(100vh - 56px); min-height: 0; overflow: hidden;">
        <div id="sideNavigation" class="col-md-auto p-2 side-navigation d-flex flex-column" style="background: #252525 !important; height: 100%; overflow: hidden;" aria-hidden="true">
          <ul class="nav navbar-nav side-navigation-list">
            <li class ="nav-item ms-1">
              <button class ="nav-link" type="button" data-bs-toggle="collapse" data-bs-target=".multi-collapse" title="Menu">
                <img src="/assets/menu.png" alt="Menu">
                <span class="collapse multi-collapse" style="font-size: 0.8rem; color: #a3cfbb">Menu</span>
              </button>
            </li>
            <li class ="nav-item ms-1">
              <a class ="nav-link" href="/" data-bs-toggle="tooltip" title="Home">
                <img src="/assets/home.png" alt="Home">
                <span class="collapse multi-collapse" style="font-size: 0.8rem; color: #a3cfbb">Home</span>
              </a>
            </li>
            <% if current_user %>
              <li class ="nav-item ms-1">
                <a class ="nav-link" href="/timesheets/<%=current_timesheet.timesheet_id rescue ''%>" data-bs-toggle="tooltip" title="Timesheets">
                  <img src="/assets/schedule.png" alt="Timesheets">
                  <span class="collapse multi-collapse" style="font-size: 0.8rem; color: #a3cfbb">Timesheet</span>
                </a>
              </li>
              <li class ="nav-item ms-1">
                <a class ="nav-link" href="/requisitions/" data-bs-toggle="tooltip" title="Requisitions">
                  <img src="/assets/requestion.png" alt="Requisitions">
                  <span class="collapse multi-collapse" style="font-size: 0.8rem; color: #a3cfbb">Requistions</span>
                </a>
              </li>
              <!--
              <li class ="nav-item ms-1">
                <a class ="nav-link" href="/projects" data-bs-toggle="tooltip" title="Programs">
                  <img src="/assets/program.png" alt="Programs">
                  <span class="collapse multi-collapse" style="font-size: 0.8rem; color: #a3cfbb">Programs</span>
                </a>
              </li> !-->
              <li class ="nav-item ms-1">
                <a class ="nav-link" href="/employees" data-bs-toggle="tooltip" title="Personnel">
                  <img src="/assets/personnel.png" alt="Personnel">
                  <span class="collapse multi-collapse" style="font-size: 0.8rem; color: #a3cfbb">Personnel</span>
                </a>
              </li>
              <li class ="nav-item ms-1">
                <a class ="nav-link" href="/inventory_items" data-bs-toggle="tooltip" title="Inventory">
                  <img src="/assets/inventory.png" alt="Inventory">
                  <span class="collapse multi-collapse" style="font-size: 0.8rem; color: #a3cfbb">Inventory</span>
                </a>
              </li>
              <li class ="nav-item ms-1">
                <a class ="nav-link" href="/business_assets" data-bs-toggle="tooltip" title="Assets">
                  <img src="/assets/asset.png" alt="Assets">
                  <span class="collapse multi-collapse" style="font-size: 0.8rem; color: #a3cfbb">Assets</span>
                </a>
              </li>
              <li class ="nav-item ms-1">
                <a class ="nav-link" href="/reports/index" data-bs-toggle="tooltip" title="Reports">
                  <img src="/assets/report.png" alt="Reports">
                  <span class="collapse multi-collapse" style="font-size: 0.8rem; color: #a3cfbb">Reports</span>
                </a>
              </li>
              <!--
              <li class ="nav-item ms-1">
                <a class ="nav-link" href="#" data-bs-toggle="tooltip" title="Complaints">
                  <img src="/assets/Complaint.png" alt="Complaints">
                  <span class="collapse multi-collapse" style="font-size: 0.8rem; color: #a3cfbb">Complaint</span>
                </a>
              </li> !-->
            <% end %>
          </ul>
          <div class="side-navigation-footer">
            <a href="/about" class="side-navigation-footer-link" title="About">
              <%= bootstrap_icon "info-circle", width: 18, height: 18, aria: { hidden: true } %>
              <span class="collapse multi-collapse">About</span>
            </a>
            <% if current_user %>
              <a href="/logout" class="side-navigation-footer-link" title="Logout">
                <%= bootstrap_icon "box-arrow-right", width: 18, height: 18, aria: { hidden: true } %>
                <span class="collapse multi-collapse">Logout</span>
              </a>
              <a href="/users/<%= current_user.user_id %>" class="side-navigation-footer-link" title="Profile">
                <%= bootstrap_icon "person-circle", width: 18, height: 18, aria: { hidden: true } %>
                <span class="collapse multi-collapse">Profile</span>
              </a>
            <% end %>
          </div>
        </div>
        <div id="sideNavigationOverlay" class="side-navigation-overlay" aria-hidden="true"></div>
        <div class="col main-content-scroll" style="height: 100%; overflow-x: hidden; overflow-y: auto;">
          <%= render partial: 'layouts/notices' %>
          <%= yield %>
          <%= turbo_frame_tag "remote_modal", target: "_top" %>
        </div>
      </div>
    </main>
    <% else %>
      <%= yield %>
    <%end%>
    <main>

    </main>
    <script>
      function initializeMobileSideNavigation() {
        const toggle = document.getElementById('mobileSideNavToggle');
        const sideNavigation = document.getElementById('sideNavigation');
        const overlay = document.getElementById('sideNavigationOverlay');

        if (!toggle || !sideNavigation || !overlay) return;

        const isMobile = window.matchMedia('(max-width: 767.98px)').matches;
        sideNavigation.setAttribute('aria-hidden', isMobile.toString());

        const closeSideNavigation = function() {
          sideNavigation.classList.remove('is-open');
          overlay.classList.remove('is-open');
          toggle.classList.remove('is-open');
          sideNavigation.setAttribute('aria-hidden', 'true');
          overlay.setAttribute('aria-hidden', 'true');
          toggle.setAttribute('aria-expanded', 'false');
        };

        toggle.onclick = function() {
          const isOpen = sideNavigation.classList.toggle('is-open');
          overlay.classList.toggle('is-open', isOpen);
          toggle.classList.toggle('is-open', isOpen);
          sideNavigation.setAttribute('aria-hidden', (!isOpen).toString());
          overlay.setAttribute('aria-hidden', (!isOpen).toString());
          toggle.setAttribute('aria-expanded', isOpen.toString());
        };

        sideNavigation.onclick = function(event) {
          if (event.target.closest('a')) closeSideNavigation();
        };

        overlay.onclick = closeSideNavigation;

        if (!document.body.dataset.mobileNavOutsideClickBound) {
          document.addEventListener('click', function(event) {
            const currentToggle = document.getElementById('mobileSideNavToggle');
            const currentSideNavigation = document.getElementById('sideNavigation');

            if (!currentToggle || !currentSideNavigation || !currentSideNavigation.classList.contains('is-open')) return;

            if (!currentSideNavigation.contains(event.target) && !currentToggle.contains(event.target)) {
              currentSideNavigation.classList.remove('is-open');
              const currentOverlay = document.getElementById('sideNavigationOverlay');
              currentOverlay.classList.remove('is-open');
              currentToggle.classList.remove('is-open');
              currentSideNavigation.setAttribute('aria-hidden', 'true');
              currentToggle.setAttribute('aria-expanded', 'false');
            }
          });

          document.body.dataset.mobileNavOutsideClickBound = 'true';
        }
      }

      document.addEventListener('DOMContentLoaded', initializeMobileSideNavigation);
      document.addEventListener('turbo:load', initializeMobileSideNavigation);
      initializeMobileSideNavigation();
    </script>
  </body>
</html>
