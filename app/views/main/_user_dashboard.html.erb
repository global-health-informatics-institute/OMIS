<div class="row">
  <div class="col">
    <p class="h4">Personal Dashboard</p>
  </div>
  <div class="col text-end">
    Welcome <%= @person.first_name %>!
  </div>
  
  <% if @person.birth_date.present? && @person.birth_date.month == Date.today.month && @person.birth_date.day == Date.today.day %>
    <div data-controller="confetti"></div>
  <% end %>
</div>

<div class="row">
  <div class="col-sm-4 d-flex">
    <section class="card flex-fill border-secondary-subtle rounded-3" aria-labelledby="empName">
      <div class="card-body p-2">
        <header class="px-4 pt-1">
          <h5 class="card-title text-dark mb-0" id="empName"><%= @person.full_name %></h5>
          <p class="fs-6 fst-italic mb-2" id="role"><%= @employee.current_position.presence || 'Position not recorded' %></p>
          <div class="d-flex flex-wrap align-items-center gap-3 fs-6 mb-1">
            <span class="d-inline-flex align-items-center gap-2">
              <%= image_tag 'data:image/svg+xml;base64,', width: 16, height: 16, alt: '' %>
              <span><%= @employee.current_department.presence || 'Department not recorded' %></span>
            </span>
            <span class="d-inline-flex align-items-center gap-2">
              <%= image_tag 'data:image/svg+xml;base64,', width: 13, height: 14, alt: '' %>
              <span><%= @employee.current_branches.presence || 'Location not recorded' %></span>
            </span>
          </div>
        </header>

        <dl class="fs-6 mb-0">
          <div class="d-flex flex-wrap align-items-center gap-2 border-top border-bottom py-2 ps-4 pe-3">
            <dt class="fw-bold text-muted me-auto">Year joined</dt>
            <dd class="mb-0 ms-auto text-end fw-normal text-muted"><time datetime="<%= @employee.employment_date.iso8601 %>"><%= @employee.employment_date.strftime('%d %b %Y') %></time></dd>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2 border-bottom py-2 ps-4 pe-1">
            <dt class="fw-bold text-muted me-auto">Contract</dt>
            <dd class="mb-0 ms-auto text-end text-muted">Not recorded</dd>
            <dd class="mb-0 badge rounded-pill text-bg-secondary d-inline-flex align-items-center justify-content-center gap-2 px-3">
              <%= image_tag 'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNiIgaGVpZ2h0PSIxNiIgZmlsbD0iI2ZmZiIgY2xhc3M9ImJpIGJpLWNpcmNsZS1maWxsIiB2aWV3Qm94PSIwIDAgMTYgMTYiPgogIDxjaXJjbGUgY3g9IjgiIGN5PSI4IiByPSI4Ii8+Cjwvc3ZnPgo=', alt: '', width: 7, height: 7 %>
              No dates
            </dd>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2 border-bottom py-2 ps-4 pe-1">
            <dt class="fw-bold text-muted me-auto">Next appraisal</dt>
            <dd class="mb-0 ms-auto text-end text-muted">Not scheduled</dd>
            <dd class="mb-0 badge rounded-pill text-bg-secondary d-inline-flex align-items-center justify-content-center gap-2 px-3">
              <%= image_tag 'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNiIgaGVpZ2h0PSIxNiIgZmlsbD0iI2ZmZiIgY2xhc3M9ImJpIGJpLWNpcmNsZS1maWxsIiB2aWV3Qm94PSIwIDAgMTYgMTYiPgogIDxjaXJjbGUgY3g9IjgiIGN5PSI4IiByPSI4Ii8+Cjwvc3ZnPgo=', alt: '', width: 7, height: 7 %>
              No date
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </div>
  <div class="col-sm-4 d-flex">
    <div class="card flex-fill">
      <div class="card-body p-2">
        <div class="row">
          <div class="col">
            <h6 class="card-title">Level Of Effort</h6>
          </div>
        </div>
        <table class="table table-bordered p-0 m-0 h-75">
         <tr>
          <td>
            Target
            <canvas id="loeTargetPie" style="height: 20vh !important; width: 10vw;margin-left: auto; margin-right: auto;"></canvas>
          </td>
          <td>
            Current
            <canvas id="loeActualPie" style="height: 20vh !important; width: 10vw;margin-left: auto; margin-right: auto;"></canvas>
          </td>
        </tr>
        </table>
      </div>
    </div>
  </div>


  <% upcoming_activities = [] %>
  <% (@upcoming_deadlines || {}).each do |timestamp, activities| %>
    <% activities.each do |description| %>
      <% upcoming_activities << { date: Time.at(timestamp).to_date, description: description, url: nil } %>
    <% end %>
  <% end %>
  <% (@direct_project_tasks || []).each do |task| %>
    <% upcoming_activities << { date: Time.parse(task['deadline']).to_date, description: task['task_description'], url: (task['reference_url?'] ? task['reference'] : nil) } %>
  <% end %>
  <% upcoming_activities.uniq! { |activity| [activity[:date], activity[:description]] } %>
  <% upcoming_activities.sort_by! { |activity| activity[:date] } %>


  <div class="col-sm-4 d-flex">
    <section class="card flex-fill border-secondary-subtle rounded-3" aria-labelledby="upcomingActivitiesTitle">
      <header class="d-flex align-items-center gap-2 px-4 py-2">
        <h5 class="card-title text-dark flex-grow-1 mb-0" id="upcomingActivitiesTitle">Upcoming Tasks &amp; Activities</h5>
        <span class="fs-6 text-body-secondary text-nowrap"><%= pluralize(upcoming_activities.length, 'item') %></span>
      </header>
      <div class="overflow-y-auto px-3" id="upcomingActivitiesViewport" tabindex="0" role="region" aria-label="Upcoming tasks and activities">
        <% if upcoming_activities.empty? %>
          <p class="fw-normal text-body-secondary text-center py-4 mb-0">No upcoming tasks or activities</p>
        <% else %>
          <ul class="list-unstyled mb-0">
            <% upcoming_activities.each do |activity| %>
              <% days_remaining = (activity[:date] - Date.current).to_i %>
              <% status_color = days_remaining < 0 ? 'danger' : (days_remaining <= 7 ? 'warning' : 'success') %>
              <% status_label = if days_remaining < 0
                   'Overdue'
                 elsif days_remaining == 0
                   'Today'
                 elsif days_remaining == 1
                   'Tomorrow'
                 elsif days_remaining < 7
                   pluralize(days_remaining, 'day')
                 else
                   pluralize((days_remaining / 7.0).ceil, 'week')
                 end %>
              <li class="border border-secondary-subtle rounded-3 overflow-hidden mb-2">
                <div class="border-start border-4 border-<%= status_color %> d-flex align-items-center justify-content-between gap-2 py-2 ps-4 pe-3">
                  <div class="flex-grow-1 text-break">
                    <p class="fs-6 fw-normal mb-1"><%= activity[:description] %></p>
                    <div class="d-flex flex-wrap align-items-center gap-3">
                      <span class="fs-6 text-body-secondary"><time datetime="<%= activity[:date].iso8601 %>"><%= activity[:date].strftime('%d %b %Y') %></time></span>
                      <% if activity[:url].present? %>
                        <%= link_to 'View', activity[:url], class: 'badge rounded-pill text-bg-primary text-decoration-none px-2' %>
                      <% end %>
                    </div>
                  </div>
                  <span class="badge rounded-pill text-bg-<%= status_color %> d-inline-flex align-items-center justify-content-center gap-2 px-3 flex-shrink-0">
                    <span class="rounded-circle <%= status_color == 'warning' ? 'bg-dark' : 'bg-white' %> p-1" aria-hidden="true"></span>
                    <%= status_label %>
                  </span>
                </div>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
      <footer class="d-flex flex-wrap align-items-center justify-content-center gap-4 px-2 py-2 mt-auto fs-6 fw-normal text-body-secondary">
        <span class="d-inline-flex align-items-center gap-2"><span class="rounded-circle bg-danger p-1" aria-hidden="true"></span>Overdue</span>
        <span class="d-inline-flex align-items-center gap-2"><span class="rounded-circle bg-warning p-1" aria-hidden="true"></span>Due soon</span>
        <span class="d-inline-flex align-items-center gap-2"><span class="rounded-circle bg-success p-1" aria-hidden="true"></span>On track</span>
      </footer>
    </section>
  </div>
</div>
<div class="row mt-4">
  <div class="col-sm-4">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title text-dark d-flex align-items-center m-0">
          Pending Actions
          <span class="badge rounded-pill bg-danger ms-2">
            <%= (@pending_actions || []).length %>
            <span class="visually-hidden">actions to perform</span>
          </span>
        </h5>

        <%# filter option %>
        <div>
          <select class="form-select form-select-sm" id="actionFilter">
            <option data-options="all">All Actions</option>
            <% (@pending_actions || []).map { |action| action[1].split('/')[1] }.uniq.each do |type| %>
              <option data-options="<%= type %>">
                <%= type.gsub(/[_-]/, ' ').titleize %>
              </option>
            <% end %>
          </select>
        </div>
      </div>
      <div class="card-body p-2 overflow-y-scroll" style="height:25vh;">
        <% if (@pending_actions || []).empty? %>
          <span class="fw-normal">No tasks assigned</span>
        <% else%>
          <ul class="list-group list-group-flush">
            <% (@pending_actions || []).each do |action| %>
              <a
              href="<%= action[1] %>"
              class="list-group-item list-group-item-action"
              data-item="<%=action[1].split('/')[1]%>"
              >
                <%= action[0] %>
              </a>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-sm-3">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="card-title text-dark">Personal Statistics</h5>
      </div>
      <div class="card-body p-2">
        <ul class="list-group ">
          <li class="list-group-item d-flex justify-content-between align-items-start list-group-item-action" onmousedown="window.location='/leave_requests'">
            <div class="ms-2 me-auto">
              <div class="fw-bold">Unused Leave</div>
              Paid leave days remaining
            </div>
            <span class="badge bg-primary rounded-pill">
              <%= ([@unused_leave, 0.0].max).round(2) %>
            </span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-start">
            <div class="ms-2 me-auto">
              <div class="fw-bold">Unsubmitted Timesheets</div>
              Overdue timesheets
            </div>
            <span class="badge bg-primary rounded-pill"><%= @outstanding_timesheets.to_s.rjust(3,' ') %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-start list-group-item-action" onmousedown="window.location='/leave_requests'">
            <div class="ms-2 me-auto">
              <div class="fw-bold">Compensatory Leave</div>
              Extra hours accumulated
            </div>
            <span class="badge bg-primary rounded-pill"><%= @employee.compensatory_leave %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-start list-group-item-action" onmousedown="window.location='/leave_requests'">
            <div class="ms-2 me-auto">
              <div class="fw-bold">Used Leave Days</div>
              Paid leave days taken this month
            </div>
            <span class="badge bg-primary rounded-pill"><%= @employee.used_leave_days %></span>
          </li>
        </ul>
      </div>
    </div>
  </div>
  <div class="col-sm-3">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="card-title text-dark">Assigned Tasks
          <span class="badge rounded-pill bg-danger">
            <%#  (@approvals || []).length %>
            <%= (@delegated_project_tasks || []).length + (@direct_project_tasks || []).length %>
            <span class="visually-hidden">actions to perform</span>
          </span>
        </h5>
      </div>
          
      <div class="overflow-y-scroll" style="height:25vh;">
  
  <%# direct project tasks %>
  <% if @direct_project_tasks.present? %>
    <ul class="list-group list-group-flush">
      <% @direct_project_tasks.each do |task| %>
        
        <% if task["reference_url?"] %>
          <a 
            href="<%= task["reference"] %>" 
            class="list-group-item list-group-item-action"
          >
            <%= task["task_description"] %>
          </a>
        <% else %>
          <div class="list-group-item list-group-item-action">
            <%= task["task_description"] %>
          </div>
        <% end %>

      <% end %>
    </ul>
  <% end %>

  <%# delegated project tasks %>
  <% if @delegated_project_tasks.present? %>
    <ul class="list-group list-group-flush">
      <% @delegated_project_tasks.each do |task| %>

        <% task["project_task_assignments"].each do |assignment| %>
          <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>
              Review task for: <b><%= assignment["employee_name"] %></b>
              <br/>
              <span class="text-muted"><%= task["task_description"] %></span>
            </div>

            <%# Bootstrap Revoke Button %>
            <%= button_to "Dismiss", 
                          revoke_project_task_assignment_path(assignment["project_task_assignment_id"]), 
                          method: :patch, 
                          params: { project_task_id: assignment["project_task_assignment_id"] }, # Pass employee_id if your backend needs it
                          class: "btn btn-outline-danger btn-sm",
                          data: { confirm: "Are you sure you want to revoke this task assignment?" },
                          form_class: "m-0" %>
          </div>
        <% end %>

      <% end %>
    </ul>
  <% end %>
</div>
    </div>
  </div>
  <div class="col-sm-2">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="card-title text-dark">Current Projects</h5>
      </div>
      <div class="card-body p-2">
        <% if (@project_names || []).empty? %>
          <h3>No Current Projects</h3>
        <% else %>
          <ul class="list-group">
            <% (@project_names || []).each do |project| %>
              <li class="list-group-item"><%= project.short_name %></li>
            <% end %>
          </ul>
        <%end%>
      </div>
    </div>
  </div>
</div>


<script>

// Size the scroll area to the first two cards, including wrapped activity text.
(() => {
  const viewport = document.getElementById('upcomingActivitiesViewport');
  const cards = viewport ? Array.from(viewport.querySelectorAll('li')) : [];
  if (cards.length <= 2) return;

  const observer = new ResizeObserver(() => {
    if (!viewport.isConnected) {
      observer.disconnect();
      return;
    }
    const first = cards[0].getBoundingClientRect();
    const second = cards[1].getBoundingClientRect();
    viewport.style.maxHeight = `${Math.ceil(second.bottom - first.top)}px`;
  });
  cards.slice(0, 2).forEach(card => observer.observe(card));
  document.addEventListener('turbo:before-cache', () => observer.disconnect(), { once: true });
})();

var labels = <%= raw((@projects_with_effort.map(&:short_name) + ['Unallocated']).to_json) %>;
var data   = <%= raw((@projects_with_effort.map(&:allocated_effort) + [@unallocated_loe]).to_json) %>;


new Chart(document.getElementById("loeTargetPie"), {
    type : 'doughnut',
    data : {
        labels : labels,
        datasets : [ {
            data : data
        } ]
    },
    options : {
        responsive: false,
        plugins: {
            legend: {
                display: false
            },
            tooltip: {
                callbacks: {
                    label: function (tooltipItem) {
                        let value = tooltipItem.formattedValue;
                        return `${value} %`;
                    }
                }
            }
        }
    }
});

  var currLabels = "<%= @loe_current.keys.join(",") %>"
  new Chart(document.getElementById("loeActualPie"), {
      type : 'doughnut',
      data : {
          labels : currLabels.split(','),
          datasets : [ {
              data : <%= @loe_current.collect { |x,y| ((y/@total_hrs)*100).floor(2) }.to_s %>
          } ]
      },
      options : {
          responsive: false,
          plugins: {
              legend: {
                  display: false
              }
          }
      }
  });

// Filter Pending actions
// Use Turbo's event to ensure the script runs after every page load/navigation
document.addEventListener('turbo:load', function() {
  const actionFilter = document.getElementById('actionFilter');
  const listItems = document.querySelectorAll('.list-group-item');

  function filterItems(selectedOption) {
    listItems.forEach(item => {
      const itemType = item.dataset.item;
      item.style.display = (selectedOption === 'all' || itemType === selectedOption) ? 'block' : 'none';
    });
  }

  if (actionFilter) {
    // Load saved selection from sessionStorage
    const savedOption = sessionStorage.getItem('actionFilterSelection');

    if (savedOption) {
      // Set the value of the select element
      actionFilter.value = savedOption;
      // Find the correct option and set its 'selected' attribute
      const optionToSelect = actionFilter.querySelector(`option[data-options="${savedOption}"]`);
      if (optionToSelect) {
        optionToSelect.selected = true;
      }
      filterItems(savedOption);
    }

    actionFilter.addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex].dataset.options;
      sessionStorage.setItem('actionFilterSelection', selectedOption);
      filterItems(selectedOption);
    });

    // Default to 'all' if nothing is saved
    if (!savedOption) {
      filterItems('all');
    }
  }
});

</script>
