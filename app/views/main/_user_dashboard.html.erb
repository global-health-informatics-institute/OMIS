      </div>
    </div>
  </div>
  <div class="col-sm-3 mb-4">
    <div class="card h-100 assigned-tasks-card">
      <div class="card-header">
        <h5 class="card-title text-dark d-flex align-items-center justify-content-between m-0">Assigned Tasks
          <span class="badge rounded-pill bg-danger">
            <%#  (@approvals || []).length %>
            <%= (@delegated_project_tasks || []).length + (@direct_project_tasks || []).length %>
            <span class="visually-hidden">actions to perform</span>
          </span>
        </h5>
        <p class="text-muted small mb-0">Tasks assigned to you.</p>
      </div>
          
      <% assigned_task_count = (@direct_project_tasks || []).length + (@delegated_project_tasks || []).length %>
      <div class="assigned-tasks-scroll <%= 'is-scrollable' if assigned_task_count > 10 %>">
  
  <%# direct project tasks %>
  <% if @direct_project_tasks.present? %>
    <ul class="list-group list-group-flush">
      <% @direct_project_tasks.each do |task| %>
        
        <% if task["reference_url?"] %>
          <a 
            href="<%= task["reference"] %>" 
            class="list-group-item list-group-item-action"
          >
            <%= task["task_description"] %>
          </a>
        <% else %>
          <div class="list-group-item list-group-item-action">
            <%= task["task_description"] %>
          </div>
        <% end %>

      <% end %>
    </ul>
  <% end %>

  <%# delegated project tasks %>
  <% if @delegated_project_tasks.present? %>
