<% if @person.birth_date.present? && @person.birth_date.month == Date.today.month && @person.birth_date.day == Date.today.day %>
  <div data-controller="confetti"></div>
<% end %>

<div class="row mt-1">
  <div class="col-sm-4">
    <div class="card h-100">
      <div class="card-body p-3">
        <h5 class="card-title mb-1 text-dark" id="empName"><%= @person.full_name %></h5>
        <p class="text-muted fs-6 mb-3"><small class="fst-italic" id="role"><%= @employee.current_position %></small></p>
       
        <div class="d-flex justify-content-between gap-3 p-2 align-items-center border-bottom border-1">
          <div class="d-flex align-items-center gap-2">
            <%= bootstrap_icon "people-fill", width: 18, height: 18, class: "text-muted flex-shrink-0" %>
            <p class="text-muted small mb-0">
              <span><%= @employee.current_department %></span>
            </p>
          </div>

          <div class="d-flex align-items-center gap-2">
            <%= bootstrap_icon "geo-alt-fill", width: 16, height: 16, class: "text-muted flex-shrink-0" %>
            <p class="text-muted small mb-0"><%= @employee.current_branches %></p>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center p-2 border-bottom border-1">
          <div class="d-flex align-items-center gap-2">
            <%= bootstrap_icon "calendar-check", width: 14, height: 14, class: "text-muted flex-shrink-0" %>
             <div class="fw-semibold text-muted small">Year Joined</div> 
          </div>
          <p class="text-muted fw-semibold small mb-0"><%= @employee.created_at.strftime('%d %b, %Y') %></p>
        </div>

        <div class="d-flex justify-content-between align-items-center p-2 border-bottom border-1">
          <div class="d-flex align-items-center gap-2">
            <%= bootstrap_icon "calendar-event", width: 14, height: 14, class: "text-muted flex-shrink-0" %>
            <div class="fw-semibold text-muted small">Contract</div>
          </div>

          <div class="d-flex align-items-center gap-2">
            <p class="text-muted fw-semibold small mb-0">
              <%= @employee.created_at.strftime('%d %b, %Y') %> -
              <%= @employee.departure_date&.strftime('%d %b, %Y') || 'N/A' %>
            </p>

            <% if @employee.departure_date.present? %>
              <% days_remaining = (@employee.departure_date - Date.current).to_i %>

              <% if days_remaining > 0 %>
                <span class="badge rounded-pill bg-success text-white">
                  <%= days_remaining %> Days left
                </span>
              <% elsif days_remaining == 0 %>
                <span class="badge rounded-pill bg-warning text-white">
                  Ends today
                </span>
              <% else %>
                <span class="badge rounded-pill bg-danger text-white">
                  Contract ended
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center p-2 border-bottom border-1">
          <div class="d-flex align-items-center gap-2">
            <%= bootstrap_icon "calendar-check", width: 14, height: 14, class: "text-muted flex-shrink-0" %>
            <div class="fw-semibold text-muted small">Next Appraisal</div>
          </div> 
          <p class="text-muted fw-semibold small mb-0">
            N/A
          </p>
        </div>

      </div>
    </div>
  </div>
  <div class="col-sm-4">
  <div class="card h-100">
    <div class="card-body p-2">

      <div class="mb-2">
        <h5 class="card-title mb-1">Level Of Effort</h5>
        <p class="text-muted small mb-0">
          Compare planned effort against the actual effort recorded.
        </p>
      </div>

      <table class="table table-bordered p-0 m-0 h-75">
        <tr>
          <td class="text-center">
            <div class="fw-semibold small mb-1">Target</div>
            <div class="text-muted small mb-2">Planned allocation</div>

            <canvas
              id="loeTargetPie"
              style="height: 140px !important; width: 140px; max-width: 100%; margin-left: auto; margin-right: auto;">
            </canvas>
          </td>

          <td class="text-center">
            <div class="fw-semibold small mb-1">Current</div>
            <div class="text-muted small mb-2">Actual effort used</div>

            <canvas
              id="loeActualPie"
              style="height: 140px !important; width: 140px; max-width: 100%; margin-left: auto; margin-right: auto;">
            </canvas>
          </td>
        </tr>
      </table>

    </div>
  </div>
</div>


  <%# RECOGNITION PANE %>

<div class="col-sm-4">
  <% activity_count = @upcoming_deadlines.values.flatten.length + Array(@direct_project_tasks).length %>
  <div class="card h-100 upcoming-activities-card <%= 'has-many' if activity_count > 10 %>" style="height: 290px; max-height: 290px; max-width: 100%; min-width: 0; overflow: hidden;">
    <div class="card-body p-2 d-flex flex-column" style="min-height: 0; overflow-x: hidden;">

      <h5 class="card-title mb-1">
        Upcoming Tasks & Activities
      </h6>

      <p class="text-muted small mb-3 d-flex justify-content-between align-items-center">
        <span>Your upcoming tasks and deadlines.</span>
        <span><%= activity_count %> items</span>
      </p>

      <div class="upcoming-activities-scroll <%= 'is-scrollable' if activity_count > 10 %>" style="flex: 1 1 auto; min-height: 0; overflow-x: hidden; overflow-y: auto;">
        <% if @upcoming_deadlines.present? %>
          <% @upcoming_deadlines.keys.sort.each do |key| %>
            <% (@upcoming_deadlines[key] || []).each do |activity| %>
              <% activity_date = Time.at(key).to_date %>
              <% days_until_due = (activity_date - Date.current).to_i %>
              <% urgency_color, urgency_label, urgency_badge = if days_until_due < 0
                                                                  ['var(--bs-danger)', 'Overdue', 'bg-danger']
                                                                elsif days_until_due.zero?
                                                                  ['var(--bs-warning)', 'Today', 'bg-warning text-dark']
                                                                elsif days_until_due <= 2
                                                                  [
                                                                    'var(--bs-success)',
                                                                    "#{days_until_due} #{days_until_due == 1 ? 'day' : 'days'}",
                                                                    'bg-success'
                                                                  ]
                                                                else
                                                                  [
                                                                    'var(--bs-success)',
                                                                    "#{(days_until_due / 7.0).ceil} #{(days_until_due / 7.0).ceil == 1 ? 'week' : 'weeks'}",
                                                                    'bg-success'
                                                                  ]
                                                                end %>
              <div class="card mb-2 border" style="border-width: 1px; border-left-width: 2px; border-left-color: <%= urgency_color %> !important;">
                <div class="card-body p-2">
                  <div class="d-flex justify-content-between align-items-center gap-2">
                    <div style="min-width: 0; overflow-wrap: anywhere;">
                      <div class="fw-semibold small"><%= activity %></div>
                      <div class="text-muted small"><%= activity_date.strftime('%d %b, %Y') %></div>
                    </div>
                    <span class="badge rounded-pill <%= urgency_badge %> flex-shrink-0"><%= urgency_label %></span>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>

        <% if @direct_project_tasks.present? %>
          <% @direct_project_tasks.each do |task| %>
            <% task_date = Time.parse(task["deadline"]).to_date %>
            <% days_until_due = (task_date - Date.current).to_i %>
            <% urgency_color, urgency_label, urgency_badge = if days_until_due < 0
                                                                ['var(--bs-danger)', 'Overdue', 'bg-danger']
                                                              elsif days_until_due.zero?
                                                                ['var(--bs-warning)', 'Today', 'bg-warning text-dark']
                                                              elsif days_until_due <= 2
                                                                [
                                                                  'var(--bs-success)',
                                                                  "#{days_until_due} #{days_until_due == 1 ? 'day' : 'days'}",
                                                                  'bg-success'
                                                                ]
                                                              else
                                                                [
                                                                  'var(--bs-success)',
                                                                  "#{(days_until_due / 7.0).ceil} #{(days_until_due / 7.0).ceil == 1 ? 'week' : 'weeks'}",
                                                                  'bg-success'
                                                                ]
                                                              end %>
            <div class="card mb-2 border" style="border-width: 1px; border-left-width: 2px; border-left-color: <%= urgency_color %> !important;">
              <div class="card-body p-2">
                <div class="d-flex justify-content-between align-items-center gap-2">
                  <div style="min-width: 0; overflow-wrap: anywhere;">
                    <div class="fw-semibold small"><%= task["task_description"] %></div>
                    <div class="text-muted small"><%= task_date.strftime('%d %b, %Y') %></div>
                  </div>
                  <span class="badge rounded-pill <%= urgency_badge %> flex-shrink-0"><%= urgency_label %></span>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>

        <% unless @upcoming_deadlines.present? || @direct_project_tasks.present? %>
          <div class="text-center py-4 text-muted">
            <%= bootstrap_icon "calendar-check", width: 24, height: 24, class: "mb-2" %>
            <p class="mb-0 fw-semibold">No upcoming activities</p>
            <small>You currently have no deadlines or scheduled tasks.</small>
          </div>
        <% end %>
      </div>

    </div>
  </div>
</div>

<%# END OF PANE %>
</div>
<div class="row mt-4 mb-4 dashboard-summary-row">
  <div class="col-sm-4 mb-4">
  <div class="card h-100 pending-actions-card">

    <div class="card-header pending-actions-header">
      <h5 class="card-title text-dark d-flex align-items-center justify-content-between w-100 m-0">
        Pending Actions

        <span class="badge rounded-pill bg-danger ms-2">
          <%= (@pending_actions || []).length %>
          <span class="visually-hidden">actions to perform</span>
        </span>
      </h5>

      <div class="pending-actions-description-row">
        <p class="text-muted small mb-0">
          Tasks and approvals that require your attention.
        </p>

        <% if (@pending_actions || []).present? %>
          <div class="pending-actions-filter">
          <select class="form-select form-select-sm" id="actionFilter">
            <option data-options="all">All Actions</option>

            <% (@pending_actions || []).map { |action| action[1].split('/')[1] }.uniq.each do |type| %>
              <option data-options="<%= type %>">
                <%= type.gsub(/[_-]/, ' ').titleize %>
              </option>
            <% end %>
          </select>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card-body p-2 pending-actions-scroll <%= 'is-scrollable' if (@pending_actions || []).length > 10 %>">

      <% if (@pending_actions || []).empty? %>

        <div class="text-center py-4">
          <%= bootstrap_icon "check-circle-fill",
                width: 28,
                height: 28,
                class: "text-success mb-2" %>

          <p class="fw-semibold mb-1">
            You're all caught up
          </p>

          <p class="text-muted small mb-0">
            There are no pending actions requiring your attention.
          </p>
        </div>

    <% else %>

        <div class="d-flex flex-column">
          <% (@pending_actions || []).each do |action| %>

            <a
              href="<%= action[1] %>"
              class="card pending-action-card mb-2 border text-decoration-none text-body"
              data-item="<%= action[1].split('/')[1] %>"
              style="min-width: 0; border-width: 1px;"
            >
              <div class="card-body p-2 d-flex justify-content-between align-items-center gap-2" style="overflow-wrap: anywhere;">
                <div>
                  <div class="fw-semibold small"><%= action[0] %></div>
                  <% if action[2].present? %>
                    <div class="text-muted small"><%= action[2] %></div>
                  <% end %>
                </div>
                <%= bootstrap_icon "chevron-right", width: 16, height: 16, class: "text-muted flex-shrink-0" %>
              </div>
            </a>

          <% end %>
        </div>

      <% end %>

    </div>
  </div>
</div>
  <div class="col-sm-3 mb-4">
    <div class="card h-100">
      <div class="card-header">
        <h5 class="card-title text-dark">Personal Statistics</h5>
        <p class="text-muted small mb-0">Your leave and timesheet summary.</p>
      </div>
      <div class="card-body p-2 personal-statistics-scroll <%= 'is-scrollable' if (@employee.used_leave_days.present? && false) %>">
        <ul class="list-group ">
          <li class="list-group-item d-flex justify-content-between align-items-start list-group-item-action" onmousedown="window.location='/leave_requests'">
