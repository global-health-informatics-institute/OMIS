<div class="row g-3">
  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header bg-light text-dark">Personal details</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-5">First name</dt>
          <dd class="col-sm-7" id="summary-first-name">—</dd>
          <dt class="col-sm-5">Middle name</dt>
          <dd class="col-sm-7" id="summary-middle-name">—</dd>
          <dt class="col-sm-5">Last name</dt>
          <dd class="col-sm-7" id="summary-last-name">—</dd>
          <dt class="col-sm-5">Birth date</dt>
          <dd class="col-sm-7" id="summary-birth-date">—</dd>
          <dt class="col-sm-5">Gender</dt>
          <dd class="col-sm-7" id="summary-gender">—</dd>
          <dt class="col-sm-5">Marital status</dt>
          <dd class="col-sm-7" id="summary-marital-status">—</dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header bg-light text-dark">Contact details</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-5">Primary phone</dt>
          <dd class="col-sm-7" id="summary-primary-phone">—</dd>
          <dt class="col-sm-5">Alternative phone</dt>
          <dd class="col-sm-7" id="summary-alt-phone">—</dd>
          <dt class="col-sm-5">Personal email</dt>
          <dd class="col-sm-7" id="summary-email">—</dd>
          <dt class="col-sm-5">Official email</dt>
          <dd class="col-sm-7" id="summary-official-email">—</dd>
          <dt class="col-sm-5">Postal address</dt>
          <dd class="col-sm-7" id="summary-postal-address">—</dd>
          <dt class="col-sm-5">Residential address</dt>
          <dd class="col-sm-7" id="summary-residential-address">—</dd>
          <dt class="col-sm-5">Landmark</dt>
          <dd class="col-sm-7" id="summary-landmark">—</dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header bg-light text-dark">Employment details</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-5">Employment date</dt>
          <dd class="col-sm-7" id="summary-employment-date">—</dd>
          <dt class="col-sm-5">Designated role</dt>
          <dd class="col-sm-7" id="summary-designated-role">—</dd>
          <dt class="col-sm-5">Role start date</dt>
          <dd class="col-sm-7" id="summary-designated-start-date">—</dd>
          <dt class="col-sm-5">Branch</dt>
          <dd class="col-sm-7" id="summary-branch">—</dd>
          <dt class="col-sm-5">Department</dt>
          <dd class="col-sm-7" id="summary-department">—</dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card h-100">
      <div class="card-header bg-light text-dark">Supervision</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-5">Supervisor</dt>
          <dd class="col-sm-7" id="summary-supervisor">—</dd>
          <dt class="col-sm-5">Started on</dt>
          <dd class="col-sm-7" id="summary-started-on">—</dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header bg-light text-dark">Levels of effort</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table mb-0">
            <thead>
              <tr>
                <th scope="col">Project</th>
                <th scope="col">Allocated effort</th>
              </tr>
            </thead>
            <tbody id="summary-levels-of-effort">
              <tr>
                <td colspan="2" class="text-muted">No levels of effort added.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
