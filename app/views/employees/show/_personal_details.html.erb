<% person = employee.person %>
<div class="card h-100">
  <div class="card-header bg-light fw-bold">Personal and contact details</div>
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-5">Name</dt>
      <dd class="col-sm-7"><%= person.full_name %></dd>
      <dt class="col-sm-5">Date of birth</dt>
      <dd class="col-sm-7"><%= person.birth_date&.strftime("%d %b, %Y") || "—" %></dd>
      <dt class="col-sm-5">Gender</dt>
      <dd class="col-sm-7"><%= person.gender.presence || "—" %></dd>
      <dt class="col-sm-5">Marital status</dt>
      <dd class="col-sm-7"><%= person.marital_status.presence || "—" %></dd>
      <dt class="col-sm-5">Primary phone</dt>
      <dd class="col-sm-7"><%= person.primary_phone.presence || "—" %></dd>
      <dt class="col-sm-5">Alternative phone</dt>
      <dd class="col-sm-7"><%= person.alt_phone.presence || "—" %></dd>
      <dt class="col-sm-5">Personal email</dt>
      <dd class="col-sm-7"><%= person.email_address.presence || "—" %></dd>
      <dt class="col-sm-5">Official email</dt>
      <dd class="col-sm-7"><%= person.official_email.presence || "—" %></dd>
      <dt class="col-sm-5">Postal address</dt>
      <dd class="col-sm-7"><%= person.postal_address.presence || "—" %></dd>
      <dt class="col-sm-5">Residential address</dt>
      <dd class="col-sm-7"><%= person.residential_address.presence || "—" %></dd>
      <dt class="col-sm-5">Landmark</dt>
      <dd class="col-sm-7"><%= person.landmark.presence || "—" %></dd>
    </dl>
  </div>
</div>
