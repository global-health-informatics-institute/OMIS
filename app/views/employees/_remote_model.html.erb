<%= turbo_frame_tag "remote_modal" do %>

  <div class="modal fade" id="shareRecipeModal" tabindex="-1" aria-labelledby="newItemRemoteModalLabel" aria-hidden="true" data-controller="remote-modal" data-action="turbo:before-render@document->remote-modal#hideBeforeRender">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document" style="height: 85vh; max-height: calc(100vh - 2rem);">
      <div class="modal-content" id="modal_content" style="height: 100%;">
        <div class="modal-header">
          <h4 class="modal-title" id="newItemRemoteModalLabel"><%= title %></h4>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body remote_modal_body" id="remote_modal_body" style="min-height: 0; overflow-y: auto;">
          <%= yield %>
        </div>
      </div>
    </div>
  </div>

<% end %>