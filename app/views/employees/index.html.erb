<%= javascript_include_tag 'custom/jquery-3.6.1.min', 'data-turbolinks-track' => false %>

<p class="h5 ">Personnel Center</p>
<div class="border p-2">
  <div class="row pt-2 pb-2">
    <div class="col-1 fs-7 fw-bold">
      Search:
    </div>
    <div class="col">
      <input class="form-control" type="text" placeholder="Search for Contact" id="textFilter">
    </div>
    <div class="col-2">
      <button class="btn btn-primary">
        Search
      </button>
    </div>
    <div class="col-4">
      <%= link_to "Add New Employee",'/employees/new' ,class: "btn btn-success" %>
    </div>
  </div>
</div>

<div class="border p-2 mt-2 fs-6">
  <table class="table table-striped table-sm" id="empTable">
    <thead class="thead-light">
    <tr>
      <th>First Name</th>
      <th>Middle Name</th>
      <th>Last Name</th>
      <th>Position</th>
      <th>Date Employed</th>
      <th>Primary Phone</th>
      <th>Alternative Phone</th>
      <th>Action</th>
    </tr>
    </thead>
    <tbody>
    <% (@list_employees || []).each do |employee| %>
      <% person = employee.person %>
      <% can_remove_employee = employee.employee_id != current_user.employee_id %>
      <tr>
        <td><%= person.first_name %></td>
        <td><%= person.middle_name %></td>
        <td><%= person.last_name %></td>
        <td><%= employee.current_position rescue " " %></td>
        <td><%= employee.employment_date.strftime('%d %b, %Y') rescue " " %></td>
        <td><%= person.primary_phone rescue " " %></td>
        <td><%= person.alt_phone rescue " " %></td>
        <th class="text-nowrap">
          <%= link_to image_tag("/assets/info.png", alt: "View employee", width: 20, height: 20),
                      employee_path(employee.employee_id),
                      class: "btn btn-outline-secondary btn-sm p-1 d-inline-flex align-items-center justify-content-center",
                      title: "View employee",
                      data: { turbo_frame: "remote_model" } %>
          <%= link_to image_tag("/assets/edit.png", alt: "Edit employee", width: 20, height: 20),
                      edit_employee_path(employee.employee_id),
                      class: "btn btn-outline-secondary btn-sm p-1 d-inline-flex align-items-center justify-content-center",
                      title: "Edit employee",
                      data: { turbo_frame: "remote_model" } %>
          <button type="button"
                  class="btn btn-outline-secondary btn-sm p-1 d-inline-flex align-items-center justify-content-center"
                  title="<%= can_remove_employee ? 'Remove employee' : 'You cannot remove your own employee record' %>"
                  data-bs-toggle="modal"
                  data-bs-target="#terminate-employee-modal-<%= employee.employee_id %>"
                  <%= 'disabled aria-disabled="true"' unless can_remove_employee %>>
            <%= image_tag("/assets/delete.png", alt: "Remove employee", width: 20, height: 20) %>
          </button>
        </th>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>    

<% (@list_employees || []).each do |employee| %>
  <%= render "employees/delete/terminate_employee_modal",
             employee: employee,
             can_remove_employee: employee.employee_id != current_user.employee_id %>
<% end %>

<script>
    $(document).ready(function(){
        $("#textFilter").on("keyup", function() {
            const value = $(this).val().toLowerCase();
            $("#empTable tr").filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });
</script>
