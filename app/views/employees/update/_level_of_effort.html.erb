<div class="tab-pane fade" id="nav-level-effort" role="tabpanel" aria-labelledby="nav-level-effort-tab">
  <%= form_with url: update_level_of_effort_employee_path(employee), method: :patch, local: true, data: { action: "submit->update-confirmation#confirm", controller: "level-of-effort", level_of_effort_projects_value: projects.to_json, level_of_effort_max_rows_value: 4 } do |form| %>
    <div data-level-of-effort-target="rows">
      <% project_teams = employee.current_projects.to_a.presence || [nil] %>
      <% project_teams.each do |project_team| %>
        <div class="row mt-3" data-level-of-effort-target="row">
          <div class="col-4">
            <%= label_tag "projects[][project]", "Project", class: "form-label" %>
            <%= select_tag "projects[][project]", options_for_select(projects, project_team&.project&.short_name), include_blank: "Select project", class: "form-select", required: true, data: { level_of_effort_target: "project", action: "change->level-of-effort#refresh" } %>
          </div>
          <div class="col-4">
            <%= label_tag "projects[][allocated_effort]", "Allocated Effort", class: "form-label" %>
            <%= number_field_tag "projects[][allocated_effort]", project_team&.allocated_effort, step: 25, max: 100, min: 0, class: "form-control", required: true, data: { level_of_effort_target: "effort", action: "input->level-of-effort#limitEffort change->level-of-effort#limitEffort" } %>
          </div>
          <div class="col-4 d-flex align-items-end gap-2">
            <button type="button" class="btn btn-danger" aria-label="Remove level of effort" data-level-of-effort-target="removeButton" data-action="level-of-effort#remove">−</button>
            <button type="button" class="btn btn-success" aria-label="Add level of effort" data-level-of-effort-target="addButton" data-action="level-of-effort#add">+</button>
          </div>
        </div>
      <% end %>
    </div>

    <div class="row g-2 mt-3 align-items-stretch">
      <div class="col-md-2 d-grid">
        <div class="bg-warning text-dark text-center rounded w-20 px-3 py-2 d-flex align-items-center justify-content-center" data-level-of-effort-target="total">Total LOE: 0%</div>
      </div>
      <div class="col-md-6 d-grid">
        <%= form.submit "Update Levels of Effort", class: "btn btn-primary w-50", disabled: true, data: { confirm_section: "Levels of Effort" } %>
      </div>
    </div>
  <% end %>
</div>
